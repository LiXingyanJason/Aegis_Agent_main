# 一期仅支持 mock；后续接入 Google / Outlook 时将在 provider 层扩展。
CALENDAR_PROVIDER=mock

# streamable-http（独立内部服务）或 stdio（本地 MCP 客户端）。
CALENDAR_MCP_TRANSPORT=streamable-http
CALENDAR_MCP_HOST=127.0.0.1
CALENDAR_MCP_PORT=9001
CALENDAR_MCP_PATH=/mcp
# Docker 或集群中按实际服务域名补充，例如 calendar-mcp:9001。
CALENDAR_MCP_ALLOWED_HOSTS=localhost,localhost:9001,127.0.0.1,127.0.0.1:9001
