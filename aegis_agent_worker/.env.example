# 与 Aegis_backend 指向同一个 PostgreSQL 和 Redis；两个服务只通过这些共享基础设施协作。
DATABASE_URL=postgresql://aegis_app:change-me@127.0.0.1:5432/aegis_pa
REDIS_URL=redis://127.0.0.1:6379/0
AGENT_QUEUE_NAME=aegis:agent-runs
AGENT_WORKER_POLL_TIMEOUT_SECONDS=5
APP_TIMEZONE=Asia/Shanghai

MODEL_PROVIDER=deepseek
MODEL_API_BASE=https://api.deepseek.com
MODEL_API_KEY=replace-me
MODEL_DEFAULT_NAME=deepseek-chat
MODEL_REQUEST_TIMEOUT_SECONDS=60

# 未配置时普通对话仍可执行，但日历工具不可用。
CALENDAR_MCP_URL=http://127.0.0.1:8001/mcp
CALENDAR_MCP_API_KEY=

# 邮件列表由主后端同步；Worker 调用 Email MCP 读取正文、生成草稿，并在逐项批准后发送。
EMAIL_MCP_URL=http://127.0.0.1:9002/mcp
EMAIL_MCP_API_KEY=
EMAIL_MCP_TIMEOUT_SECONDS=20

# 知识库 Embedding：默认关闭，独立配置，不继承聊天模型/密钥。
EMBEDDING_ENABLED=false
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_API_BASE=https://your-embedding-provider.example/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_MODEL_VERSION=
EMBEDDING_DIMENSIONS=1536
EMBEDDING_SEND_DIMENSIONS=false
EMBEDDING_REQUEST_TIMEOUT_SECONDS=30
EMBEDDING_MAX_BATCH_ITEMS=10
# 查询文本是否允许发送到外部供应商。只对已获授权的开发场景开启。
EMBEDDING_EXTERNAL_QUERIES_ALLOWED=false

# 6.4查询：默认关闭，启用前先索引并显式启用资料、授权查询文本外发。
KNOWLEDGE_QUERY_ENABLED=false
# 仅Qdrant服务不可用可降级；不兜底预算/授权/超时/集合配置错误。
KNOWLEDGE_LEXICAL_FALLBACK_ALLOWED=false

# 远端 Qdrant Cloud 免费集群；6.3索引写入与6.4只读查询已接入。
QDRANT_ENABLED=false
# 填控制台提供的 HTTPS 集群地址（含所需端口），不要填控制台页面地址。
QDRANT_URL=
# Database API Key，不是 Cloud Management Key。不要提交真实密钥。
QDRANT_API_KEY=
# 索引消费者使用的写权限数据库密钥；查询密钥建议只读。
QDRANT_WRITE_API_KEY=
QDRANT_COLLECTION=aegis_knowledge_v1
QDRANT_REQUEST_TIMEOUT_SECONDS=10

# 以单独Index Worker进程消费，不占用Agent对话循环。
KNOWLEDGE_INDEX_QUEUE_NAME=aegis:knowledge-index-jobs
KNOWLEDGE_STORAGE_ROOT=D:/AI/Aegis_Agent_main/data/knowledge-sources
KNOWLEDGE_MAX_SOURCE_BYTES=262144
KNOWLEDGE_INDEX_LEASE_SECONDS=180
KNOWLEDGE_INDEX_RECOVERY_SECONDS=30
KNOWLEDGE_INDEX_MAX_CLAIMS=3

# 7.2工作索引缓存灰度开关；只缓存当前会话任务状态/卡片引用，不缓存正文。
SESSION_MEMORY_ENABLED=false

# 8.1固定跨领域协同：邮件绝对日期/搜索窗口/时长→日历候选→待确认会议草稿。
# 旧任务保留原Harness策略，开启后新任务使用独立v3策略，不允许自动发送邮件。
FIXED_COOPERATION_ENABLED=false
