# PostgreSQL：数据库名为 aegis_pa；不要提交真实凭据。
DATABASE_URL=postgresql+asyncpg://数据库用户名称:数据库密码@127.0.0.1:5432/aegis_pa
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://127.0.0.1:6379/0
# Agent 任务队列
AGENT_QUEUE_NAME=aegis:agent-runs
AGENT_WORKER_POLL_TIMEOUT_SECONDS=5

# Keycloak OIDC登录认证
OIDC_ISSUER_URL=http://127.0.0.1:8080/realms/aegis
OIDC_AUDIENCE=aegis-pa-api
OIDC_CLIENT_ID=aegis-pa-web
# 仅本地开发可开启；生产环境保持 false，并由管理员预先创建用户与租户映射。
AUTO_PROVISION_USERS=false
DEFAULT_TENANT_NAME=

# 模型服务
MODEL_PROVIDER=openai
MODEL_API_BASE=https://api.openai.com/v1
MODEL_API_KEY=replace-with-a-secret
MODEL_DEFAULT_NAME=gpt-4.1-mini
MODEL_REQUEST_TIMEOUT_SECONDS=60



