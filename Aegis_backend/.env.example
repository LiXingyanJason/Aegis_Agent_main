# PostgreSQL：数据库名为 aegis_pa；不要提交真实凭据。
DATABASE_URL=postgresql+asyncpg://数据库用户名称:数据库密码@127.0.0.1:5432/aegis_pa
DATABASE_ECHO=false

# 最小 OpenTelemetry 与结构化日志。开发时可设为 true，在终端输出完整 Trace Span。
OTEL_ENABLED=true
OTEL_SERVICE_NAME=aegis-pa-api
OTEL_CONSOLE_EXPORTER=false

# Redis
REDIS_URL=redis://127.0.0.1:6379/0
# Agent 任务队列
AGENT_QUEUE_NAME=aegis:agent-runs
AGENT_WORKER_POLL_TIMEOUT_SECONDS=5

# 当前一期以该时区解释“今天”“明天”等相对日期；后续将升级为用户偏好。
APP_TIMEZONE=Asia/Shanghai

# Calendar MCP Server（主后端页面读取 list_events/get_event；Worker 负责空闲查询及审批后写入）
# 主后端与 Worker 分别配置 URL，页面不会使用 Worker 的 .env。
# CALENDAR_MCP_URL=http://127.0.0.1:9001/mcp
# CALENDAR_MCP_API_KEY=replace-with-calendar-mcp-secret
CALENDAR_MCP_TIMEOUT_SECONDS=20

# Email MCP Server（主后端同步邮件元数据；Agent Worker 读取正文、生成草稿并在批准后发送）
# 未部署邮件工具服务时，邮件管理页面会提示连接不可用；不返回虚构邮件。
# EMAIL_MCP_URL=http://127.0.0.1:9002/mcp
# EMAIL_MCP_API_KEY=replace-with-email-mcp-secret
EMAIL_MCP_TIMEOUT_SECONDS=20

# Keycloak OIDC登录认证
OIDC_ISSUER_URL=http://127.0.0.1:8080/realms/aegis
OIDC_AUDIENCE=aegis-pa-api
OIDC_CLIENT_ID=aegis-pa-web
# 仅本地开发可开启；生产环境保持 false，并由管理员预先创建用户与租户映射。
AUTO_PROVISION_USERS=false
DEFAULT_TENANT_NAME=

# 模型服务
MODEL_PROVIDER=openai
MODEL_API_BASE=https://api.openai.com/v1
MODEL_API_KEY=replace-with-a-secret
MODEL_DEFAULT_NAME=gpt-4.1-mini
MODEL_REQUEST_TIMEOUT_SECONDS=60

# 知识导入：API与Index Worker必须使用同一个绝对源文件根目录/共享卷。
KNOWLEDGE_STORAGE_ROOT=D:/AI/Aegis_Agent_main/data/knowledge-sources
KNOWLEDGE_MAX_SOURCE_BYTES=262144
KNOWLEDGE_INDEX_QUEUE_NAME=aegis:knowledge-index-jobs
# 仅模型元数据，与Worker .env保持完全一致；API不需要Embedding密钥。
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_MODEL_VERSION=text-embedding-v4-profile-v1
EMBEDDING_DIMENSIONS=1024



